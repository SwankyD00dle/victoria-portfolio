---
import "@/styles/app.css";

type Props = { title: string; description: string; image?: string; noindex?: boolean };
const { title, description, image, noindex = false } = Astro.props;
const site = Astro.site || new URL("https://www.victoriatu.info");
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href="/fonts/satoshi-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/publicsans-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {image && <meta property="og:image" content={new URL(image, site)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <slot />
  </body>
</html>
